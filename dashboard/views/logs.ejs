<%- contentFor('body') %>

<div class="logs-page space-y-6">
    <div class="logs-panel bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <div class="logs-page-header flex items-center justify-between mb-6">
            <div>
                <span class="logs-kicker">EVENT MONITORING</span>
                <h2 class="text-2xl font-bold text-gray-800 dark:text-white"><%= locale.dashboard.logs.title %></h2>
                <p class="logs-subtitle">Choose where each server event should be recorded.</p>
            </div>
            <div class="logs-actions flex items-center space-x-4">
                <button id="enableAllLogs" class="logs-action logs-action-success px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-all">
                    <i class="fas fa-check-circle mr-2"></i>
                    <%= locale.dashboard.logs.enableAll %>
                </button>
                <button id="disableAllLogs" class="logs-action logs-action-danger px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-all">
                    <i class="fas fa-times-circle mr-2"></i>
                    <%= locale.dashboard.logs.disableAll %>
                </button>
            </div>
        </div>

        <div class="logs-search relative mb-6">
            <input type="text" id="logSearch" placeholder="<%= locale.dashboard.logs.search %>" 
                   class="w-full px-4 py-2 bg-gray-100 dark:bg-gray-700 rounded-lg pl-10 focus:outline-none focus:ring-2 focus:ring-blue-500">
            <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="logsGrid">
            <% Object.entries(settings.logs).forEach(([key, value]) => { 
                if (key !== 'enabled' && typeof value === 'object') { %>
                <div class="log-card bg-gray-50 dark:bg-gray-700 rounded-lg p-6 hover:shadow-lg transition-all" data-log="<%= key %>">
                    <div class="flex items-start justify-between mb-4">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-1">
                                <%= locale.dashboard.logs.types[key] || key %>
                            </h3>
                            <p class="text-sm text-gray-600 dark:text-gray-400">
                                <%= locale.dashboard.logs.descriptions[key] || '' %>
                            </p>
                        </div>
                        <div class="flex items-center">
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" class="sr-only log-toggle" 
                                       data-log="<%= key %>"
                                       <%= value.enabled ? 'checked' : '' %>>
                                <div class="log-toggle-track"></div>
                            </label>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="form-group">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <%= locale.dashboard.logs.channel %>
                            </label>
                            <select class="log-channel w-full bg-white dark:bg-gray-600 border border-gray-300 dark:border-gray-500 rounded-lg px-3 py-2"
                                    data-log="<%= key %>">
                                <option value=""><%= locale.dashboard.logs.selectChannel %></option>
                                <% channels.forEach(channel => { %>
                                    <option value="<%= channel.id %>" 
                                            <%= value.channelId === channel.id ? 'selected' : '' %>>
                                        #<%= channel.name %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <%= locale.dashboard.logs.embedColor %>
                            </label>
                            <input type="color" class="log-color w-full h-10 rounded-lg cursor-pointer"
                                   data-log="<%= key %>" 
                                   value="<%= value.color || '#777bc9' %>">
                        </div>

                        <% if (['messageDelete', 'messageEdit'].includes(key)) { %>
                            <div class="flex items-center mt-4">
                                <input type="checkbox" id="ignoreBots_<%= key %>" 
                                       class="log-ignore-bots"
                                       data-log="<%= key %>"
                                       <%= value.ignoreBots ? 'checked' : '' %>>
                                <label for="ignoreBots_<%= key %>" class="ml-2 text-sm text-gray-600 dark:text-gray-400">
                                    <%= locale.dashboard.logs.ignoreBots %>
                                </label>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }}); %>
        </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-800 dark:text-white mb-2"><%= locale.dashboard.assetImporter.title %></h2>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-5"><%= locale.dashboard.assetImporter.description %></p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300"><%= locale.dashboard.assetImporter.emojiChannel %>
                <select id="assetEmojiChannel" class="mt-2 w-full bg-white dark:bg-gray-600 border border-gray-300 dark:border-gray-500 rounded-lg px-3 py-2">
                    <option value=""><%= locale.dashboard.assetImporter.disabled %></option>
                    <% channels.forEach(channel => { %><option value="<%= channel.id %>" <%= settings.assetImport?.emojiChannelId === channel.id ? 'selected' : '' %>>#<%= channel.name %></option><% }) %>
                </select>
            </label>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300"><%= locale.dashboard.assetImporter.stickerChannel %>
                <select id="assetStickerChannel" class="mt-2 w-full bg-white dark:bg-gray-600 border border-gray-300 dark:border-gray-500 rounded-lg px-3 py-2">
                    <option value=""><%= locale.dashboard.assetImporter.disabled %></option>
                    <% channels.forEach(channel => { %><option value="<%= channel.id %>" <%= settings.assetImport?.stickerChannelId === channel.id ? 'selected' : '' %>>#<%= channel.name %></option><% }) %>
                </select>
            </label>
        </div>
        <label class="block mt-5 text-sm font-medium text-gray-700 dark:text-gray-300">
            <%= currentLang === 'ar' ? 'رتب تجاوز السجل' : 'Roles that bypass logs' %>
            <div class="role-bypass-dropdown" id="assetLogBypassRoles" data-open="false">
                <button type="button" class="role-bypass-trigger" aria-expanded="false">
                    <span class="role-bypass-trigger-text"><%= currentLang === 'ar' ? 'اختر الرتب' : 'Select roles' %></span>
                    <i class="fas fa-chevron-down"></i>
                </button>
                <div class="role-bypass-menu" role="listbox">
                    <% roles.forEach(role => { %>
                        <label class="role-bypass-option">
                            <input type="checkbox" value="<%= role.id %>" <%= (settings.assetImport?.logBypassRoleIds || []).includes(role.id) ? 'checked' : '' %>>
                            <span class="role-color-dot" style="background-color:<%= role.color || '#99a1b3' %>"></span>
                            <span><%= role.name %></span>
                        </label>
                    <% }) %>
                </div>
            </div>
            <span class="block mt-1 text-xs text-gray-500"><%= currentLang === 'ar' ? 'أي إجراء من عضو يحمل هذه الرتبة لن يظهر في سجلات البوت.' : 'Actions performed by members with these roles will not be sent to bot logs.' %></span>
        </label>
        <button id="saveAssetImport" class="mt-5 px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600"><%= locale.dashboard.assetImporter.save %></button>
    </div>
</div>

<div id="saveChangesModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white dark:bg-gray-800 rounded-lg p-6 max-w-md w-full mx-4">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
            <%= locale.dashboard.logs.saveChanges %>
        </h3>
        <p class="text-gray-600 dark:text-gray-400 mb-6">
            <%= locale.dashboard.logs.saveChangesDescription %>
        </p>
        <div class="flex justify-end space-x-4">
            <button id="cancelSave" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-all">
                <%= locale.dashboard.logs.cancel %>
            </button>
            <button id="confirmSave" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-all">
                <%= locale.dashboard.logs.save %>
            </button>
        </div>
    </div>
</div> 
