{
    "name": "moderation-bot",
    "version": "1.0.0",
    "description": "A powerful Discord moderation bot with an advanced dashboard, extensive protection systems, and customizable moderation tools",
    "main": "dist/index.js",
    "scripts": {
        "clean": "rimraf dist",
        "prebuild": "npm run clean",
        "build": "tsc",
        "postbuild": "ts-node scripts/copyFiles.ts",
        "start": "node dist/index.js",
        "build:start": "npm run build && npm run start",
        "predev": "npm run check",
        "dev": "npm run setup && nodemon -e ts,json,ejs --exec ts-node index.ts",
        "watch": "tsc -w",
        "lint": "eslint . --ext .ts",
        "test": "echo \"No tests specified\" && exit 0",
        "rebuild": "npm run clean && npm run build",
        "setup": "ts-node scripts/setup.ts",
        "check": "ts-node scripts/check-env.ts",
        "production": "NODE_ENV=production npm run build:start"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wickstudio/moderation-bot.git"
    },
    "keywords": [
        "discord",
        "bot",
        "moderation",
        "typescript",
        "dashboard",
        "discord.js",
        "protection",
        "security",
        "tickets",
        "giveaway",
        "logging"
    ],
    "author": {
        "name": "Wick Studio",
        "email": "info@wick-studio.com",
        "url": "https://github.com/wickstudio"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/wickstudio/moderation-bot/issues"
    },
    "homepage": "https://github.com/wickstudio/moderation-bot#readme",
    "dependencies": {
        "@discordjs/voice": "^0.19.2",
        "@libsql/client": "^0.18.0",
        "@napi-rs/canvas": "^1.0.9",
        "axios": "^1.20.0",
        "chokidar": "^3.6.0",
        "cookie-parser": "^1.4.7",
        "discord-html-transcripts": "^3.3.0",
        "discord.js": "^14.27.0",
        "dotenv": "^16.4.5",
        "ejs": "^3.1.10",
        "express": "^5.2.1",
        "express-ejs-layouts": "^2.5.1",
        "express-session": "^1.19.0",
        "ms": "^2.1.3",
        "opusscript": "^0.0.8",
        "play-dl": "^1.9.7",
        "sharp": "^0.35.4"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/ejs": "^3.1.5",
        "@types/express": "^4.17.25",
        "@types/express-ejs-layouts": "^2.5.4",
        "@types/express-session": "^1.19.0",
        "@types/fs-extra": "^11.0.4",
        "@types/glob": "^8.1.0",
        "@types/ms": "^2.1.0",
        "@types/node": "^20.19.43",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "concurrently": "^8.2.2",
        "eslint": "^8.57.1",
        "fs-extra": "^11.4.0",
        "glob": "^10.5.0",
        "nodemon": "^3.1.14",
        "rimraf": "^5.0.10",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "funding": {
        "type": "individual",
        "url": "https://github.com/sponsors/wickstudio"
    },
    "contributors": [
        {
            "name": "Wick Studio",
            "url": "https://github.com/wickstudio"
        }
    ],
    "private": false
}
